void get_motor_updown_time(){
  int i = 0;
  i += Slow_Lift_Distance * 10000;
  i += Fast_Lift_Distance * 1000;
  i += Slow_Lift_Feedrate * 10;
  i += Fast_Lift_Feedrate;
  i += Drop_Back_Feedrate / 10;

  if (i < 11222 || i > 33555) return;          // out of range -> leave value unchanged
  int d1 = i / 10000 % 10, d2 = i / 1000 % 10, d3 = i / 100 % 10,
      d4 = i / 10 % 10,     d5 = i % 10;
  if (d1 < 1 || d1 > 3 || d2 < 1 || d2 > 3 ||
      d3 < 2 || d3 > 5 || d4 < 2 || d4 > 5 ||
      d5 < 2 || d5 > 5) return;                // unmatched key -> leave value unchanged
  int idx = (d1 - 1) * 192 + (d2 - 1) * 64 + (d3 - 2) * 16 + (d4 - 2) * 4 + (d5 - 2);
  motor_updown_time = MOTOR_UPDOWN_TIME[idx];  // .rodata (flash) on ESP32
}
