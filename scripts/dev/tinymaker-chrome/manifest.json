{
  "manifest_version": 3,
  "name": "TinyMaker status",
  "version": "0.3.0",
  "description": "TinyMaker printer status on the toolbar: print progress on the icon, a model preview and details in the popup, and a notification when the print finishes.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TinyMaker",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["alarms", "storage", "scripting"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["http://*/*"]
}
